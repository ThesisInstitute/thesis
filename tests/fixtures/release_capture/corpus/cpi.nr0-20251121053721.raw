	<td headers="cpi_pressa.r.1.3.2.3 cpi_pressa.h.1.2 cpi_pressa.h.2.7"><span class="datavalue">-0.1</span></td>
	<td headers="cpi_pressa.r.1.3.2.3 cpi_pressa.h.1.2 cpi_pressa.h.2.8"><span class="datavalue">0.3</span></td>
	<td headers="cpi_pressa.r.1.3.2.3 cpi_pressa.h.1.9"><span class="datavalue">3.9</span></td>
</tr>

</tbody>

<!-- table notes --><tfoot>
<tr class="footnotes">
<td class="footnotes" colspan="9">
	<p class="footnotes">
		<span class="footnotestitle">Footnotes</span><br />
		<a id="cpi_pressa.f.1" name="cpi_pressa.f.1">(1) </a>Not seasonally adjusted.<br />
