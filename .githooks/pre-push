#!/bin/sh
# Records-path guard. GitHub cannot enforce this server-side (public source
# repos cannot have push rulesets — verified 2026-07-25, HTTP 422), so this
# is the local half of the control: records/** belongs to the allowlisted
# workflows, which attest every push. Local pushes have twice produced
# permanently waived, unattested commits (2026-07-20/21 Next50 wave,
# 2026-07-22 QCEW completion). The CI audit still catches what slips past.
#
# The check is commit-level, mirroring scripts/verify_records_attestations.py:
# the push is refused when any commit it would publish touches records/**
# (a git log --full-history walk — endpoint tree diffs miss add-then-delete
# commits and depend on an arbitrary merge base under criss-cross histories;
# the audit walks commits, so the guard walks the same way). Both halves of
# the audit's merge rule are mirrored:
#   - merge_is_records_noop: a merge whose records tree is byte-identical to
#     a parent publishes no new records content and is exempt — otherwise
#     every update-with-main merge after a recorder push trips the guard.
#     Only an IN-SCOPE parent may exempt, in the audit's exact sense: not a
#     proven ancestor of the enforcement epoch (the commit that introduced
#     the verifier, resolved here the same self-anchoring way, from the
#     graph BEING PUSHED rather than from ambient HEAD). The guard runs
#     before the audit ever sees the commit, so it asks one thing more:
#     that merging the commit into the comparator (git merge-tree, the
#     merge GitHub would compute) leave the comparator's records exactly as
#     they are. A merge that passes publishes nothing main lacks and rolls
#     nothing main holds back. It admits a branch that merged main forward
#     and then merges a side branch lagging main's records (hit
#     2026-09-22), a branch whose sibling PR has since landed on main, and
#     a merge that keeps main's restoration of an earlier state. It refuses
#     a merge that carries records main does not have, and every rollback
#     of main's records the merge would bring: `git merge -s ours main`, a
#     literal stale parent, an unpublished child of newer main, an octopus,
#     re-selecting a state a published merge discarded, resurrecting
#     records a published merge deleted. A records conflict in that merge,
#     unrelated histories, or a git without merge-tree --write-tree exempt
#     nothing. A tree merely EQUAL to main's that the branch built by hand
#     is exempt as a merge — merging it changes nothing — but the commit
#     that built it is not a merge and is refused on its own.
#     Git's path walk skips a merge whose only differing parent is already
#     on the comparator (`git merge -s ours` of an older main commit), so
#     every merge in the range whose records differ from any parent is
#     judged the same way, walked or not. An ancient records state
#     resurrected through a pre-epoch parent is what the epoch test
#     refuses. No resolvable epoch means no exemption at all — never a
#     weaker one. This is stricter than the audit's merge rule, which
#     never sees a branch and so has no notion of a rollback relative to
#     main.
#   - enforce_range_content_closure: if nothing in the range needs
#     attestation yet the endpoints disagree about records content, the
#     change rode in through parent-order trickery or a rewind. Applied to
#     main pushes, where the audit applies it (a branch legitimately lags
#     main's records).
#
# The comparator is fetched from the push destination itself — the URL git
# hands the hook, verified to survive git's own URL rewriting unchanged, so
# a nested insteadOf cannot redirect the comparator to a different
# repository than the one receiving the push — and resolved immediately to
# an immutable object id, so concurrent pushes cannot swap it. Nothing
# rests on remote naming or URL spelling: a fork, a mirror, a
# remote.origin.pushurl, an https-fetch/ssh-push pair and a plain clone all
# get measured against the main their own push is landing beside; anything
# unverifiable falls back to the endpoint range. The walked range is:
#   - refs/heads/main: remote..local — every commit published there is
#     audited on arrival, so every one is checked here.
#   - any other ref: destination-main..local — the branch's own
#     contribution. Tip-to-tip ranges false-positive here: a branch rebased
#     onto a main that legitimately gained attested recorder commits showed
#     main's records growth while pushing zero new records objects (hit
#     2026-07-31).
# A push with no trustworthy comparator (a new ref whose destination has no
# main), an unwalkable range, or a shallow repository — whose walk can
# succeed while missing the history that matters — is refused. Replacement
# refs and grafts are neutralized so local graph overlays cannot dress up a
# records commit.
#
# Break glass, deliberately, when you truly mean it:
#   THESIS_ALLOW_RECORDS_PUSH=1 git push ...
GIT_NO_REPLACE_OBJECTS=1
GIT_GRAFT_FILE=/dev/null
export GIT_NO_REPLACE_OBJECTS GIT_GRAFT_FILE
destination=$2
# Unique per invocation, including across linked worktrees: a shared ref
# could be repointed by a concurrent push between fetch and walk.
DEST_REF="refs/prepush-guard/tmp-$$"
VERIFIER=scripts/verify_records_attestations.py
ZERO=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
status=0
fetched=0
dest_main=""

cleanup() { git update-ref -d "$DEST_REF" 2>/dev/null; }
trap cleanup EXIT HUP INT TERM

shallow=$(git rev-parse --is-shallow-repository 2>/dev/null || echo unknown)

refuse() { # refuse <ref> <reason>
    if [ "$THESIS_ALLOW_RECORDS_PUSH" = "1" ]; then
        echo "pre-push: unverifiable $1 allowed by THESIS_ALLOW_RECORDS_PUSH=1" >&2
        return 0
    fi
    echo "" >&2
    echo "BLOCKED: cannot verify $1 against records/** ($2)." >&2
    echo "Fetch or unshallow what is missing and retry, or set" >&2
    echo "THESIS_ALLOW_RECORDS_PUSH=1 to push unverified — that still" >&2
    echo "lands unattested and costs a permanent public waiver." >&2
    echo "" >&2
    return 1
}

records_tree() { # records_tree <commit-ish>
    git rev-parse --quiet --verify "$1:records" 2>/dev/null || echo none
}

# Pin the comparator to the destination's own main, once per push, as an
# immutable object id. Git already resolved the destination; if feeding it
# back through fetch would rewrite it again (a nested insteadOf), the
# fetched repository need not be the receiving one, so the comparator is
# refused and the endpoint range is used instead.
pin_destination_main() {
    if [ "$fetched" = "0" ]; then
        fetched=1
        if [ -n "$destination" ] &&
            [ "$(git ls-remote --get-url "$destination" 2>/dev/null)" \
                = "$destination" ] &&
            GIT_TERMINAL_PROMPT=0 git fetch --quiet --no-tags \
                "$destination" "+refs/heads/main:$DEST_REF" \
                </dev/null >/dev/null 2>&1; then
            dest_main=$(git rev-parse --quiet --verify "$DEST_REF^{commit}" \
                2>/dev/null)
        fi
        cleanup
    fi
    [ -n "$dest_main" ]
}

# The enforcement epoch, resolved exactly as the audit resolves it — the
# single commit that introduced the verifier — but from the graph being
# pushed, not from ambient HEAD. Unresolvable means no exemption at all.
epoch_of() { # epoch_of <commit>
    commits=$(git log --full-history --diff-filter=A --format=%H "$1" -- \
        "$VERIFIER" 2>/dev/null)
    [ "$(printf '%s\n' "$commits" | grep -c .)" = "1" ] || return 1
    printf '%s\n' "$commits"
}

# A parent may vouch for a merge only if the audit would let it: its records
# tree is the merge's, and it is in scope (not a proven ancestor of the
# epoch). A vouched merge is exempt only if merging it into the comparator
# leaves the comparator's records as they are (merge_keeps_records).
parent_may_vouch() { # parent_may_vouch <parent> <epoch> <merge>
    [ -n "$2" ] || return 1
    [ "$(records_tree "$1")" = "$(records_tree "$3")" ] || return 1
    ! git merge-base --is-ancestor "$1" "$2" 2>/dev/null
}
merge_keeps_records() { # merge_keeps_records <merge> <comparator>
    out=$(git merge-tree --write-tree --name-only --no-messages "$2" "$1" \
        2>/dev/null)
    rc=$?
    [ "$rc" -le 1 ] || return 1
    tree=$(printf '%s\n' "$out" | sed -n 1p)
    [ -n "$tree" ] || return 1
    if [ "$rc" = "1" ] &&
        printf '%s\n' "$out" | sed 1d | grep -Eq '^records(/|$)'; then
        return 1
    fi
    [ "$(records_tree "$tree")" = "$(records_tree "$2")" ]
}
# Merges in the range whose records tree differs from any parent, including
# parents already on the comparator, which git's path walk does not compare.
records_merges() { # records_merges <range>
    merges=$(git rev-list --merges "$1" 2>/dev/null) || return 1
    for m in $merges; do
        mt=$(records_tree "$m")
        for q in $(git rev-parse "$m^@" 2>/dev/null); do
            if [ "$(records_tree "$q")" != "$mt" ]; then
                echo "$m"
                break
            fi
        done
    done
}

while read -r _local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue
    if [ "$shallow" != "false" ]; then
        refuse "$remote_ref" "shallow or unreadable repository" || status=1
        continue
    fi
    base=""
    if [ "$remote_ref" != "refs/heads/main" ] && pin_destination_main; then
        base=$dest_main
    fi
    if [ -z "$base" ]; then
        if [ "$remote_sha" != "$ZERO" ]; then
            base="$remote_sha"
        elif pin_destination_main; then
            base=$dest_main
        else
            refuse "$remote_ref" "new ref, no comparator at the destination" ||
                status=1
            continue
        fi
    fi
    range="$base..$local_sha"
    walked=$(git -c log.follow=false -c diff.ignoreSubmodules=none log \
        --full-history --format=%H "$range" -- records/ 2>/dev/null)
    walk_rc=$?
    if [ "$walk_rc" -ne 0 ]; then
        refuse "$remote_ref" "range $range failed to walk" || status=1
        continue
    fi
    if ! extra=$(records_merges "$range"); then
        refuse "$remote_ref" "range $range failed to list merges" || status=1
        continue
    fi
    candidates=$(printf '%s\n%s\n' "$walked" "$extra" | awk 'NF && !seen[$0]++')
    epoch=$(epoch_of "$local_sha") || epoch=""
    offenders=""
    for c in $candidates; do
        nparent=0
        vouched=0
        for p in $(git rev-parse "$c^@" 2>/dev/null); do
            nparent=$((nparent + 1))
            parent_may_vouch "$p" "$epoch" "$c" && vouched=1
        done
        if [ "$nparent" -ge 2 ] && [ "$vouched" = "1" ] &&
            merge_keeps_records "$c" "$base"; then
            continue
        fi
        offenders="$offenders $c"
    done
    if [ -z "$offenders" ]; then
        # enforce_range_content_closure, for the ref the audit audits.
        if [ "$remote_ref" = "refs/heads/main" ] &&
            [ "$(records_tree "$base")" != "$(records_tree "$local_sha")" ]; then
            refuse "$remote_ref" \
                "records content differs across $range with no attestable commit" ||
                status=1
        fi
        continue
    fi
    if [ "$THESIS_ALLOW_RECORDS_PUSH" = "1" ]; then
        echo "pre-push: records/** push allowed by THESIS_ALLOW_RECORDS_PUSH=1" >&2
        continue
    fi
    echo "" >&2
    echo "BLOCKED: this push publishes commits that touch records/**." >&2
    # shellcheck disable=SC2086
    git log --no-walk=unsorted --format="  %h %s" $offenders >&2 2>/dev/null
    # shellcheck disable=SC2086
    paths=$(git log --no-walk --diff-merges=first-parent --format= \
        --name-only $offenders -- records/ 2>/dev/null |
        grep -v '^$' | sort -u)
    if [ -n "$paths" ]; then
        echo "  paths:" >&2
        printf '%s\n' "$paths" | head -5 | sed 's/^/    /' >&2
    fi
    echo "" >&2
    echo "records/** is written by the allowlisted workflows, which attest" >&2
    echo "each push. A local push lands unattested and can only be recorded" >&2
    echo "as a permanent public waiver (see WAIVED_UNATTESTED_COMMITS)." >&2
    echo "Use the workflow that owns this record, or set" >&2
    echo "THESIS_ALLOW_RECORDS_PUSH=1 if you genuinely mean to waive it." >&2
    echo "" >&2
    status=1
done
exit $status
