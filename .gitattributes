# The custody chain hashes everything under records/ byte-for-byte. Git's
# line-ending translation (core.autocrlf, on by default in Git for Windows)
# rewrites LF to CRLF at checkout, which changes those bytes and breaks every
# digest hash — scripts/verify_record_chain.py reports CHAIN BROKEN on a clean
# clone even though the records are intact. Never translate these paths.
records/** -text

# Challenge submissions are hashed on intake for the same reason.
challenge/** -text

# QCEW CSV fixtures are byte-for-byte official BLS responses. Preserve the
# agency's CRLF line endings and review them through their authenticated hash.
tests/fixtures/qcew/*.csv binary

# EIA dnav fixtures are byte-for-byte official responses. Preserve the
# source HTML line endings, the legacy XLS container, and the no-newline API
# error response so their documented SHA-256 digests remain reproducible.
tests/fixtures/eia_dnav/*.html binary
tests/fixtures/eia_dnav/*.xls binary
tests/fixtures/eia_dnav/api-no-key.json binary

# Release-capture fixtures are the exact bodies the Internet Archive stores,
# checked against its index digest (JOLTS Table 4 keeps BLS's CRLF lines).
tests/fixtures/release_capture/*.raw binary

# Archive capture bodies are checked against the index digest byte-for-byte;
# half are plain HTML, which line-ending translation would rewrite, and their
# whitespace is the page's own.
tests/fixtures/release_capture/**/*.raw -text -whitespace
